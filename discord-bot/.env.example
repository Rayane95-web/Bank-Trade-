# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_test_guild_id        # Optional: for instant slash command deploy in dev

# ── /devinfo command ──────────────────────────────────────────────────────────
DEV_NAME=YourName
DEV_DISCORD=YourTag
DEV_GITHUB=https://github.com/yourhandle
DEV_WEBSITE=https://yourwebsite.com
DEV_BIO=I build Discord bots.
DEV_AVATAR_URL=                    # Optional: direct image URL

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL_ID=                    # Optional: channel ID for admin action logs

# ── Bot ───────────────────────────────────────────────────────────────────────
BOT_VERSION=2.0.0
